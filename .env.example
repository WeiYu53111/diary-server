# ==============================================
# 日记服务端 Docker Compose 环境变量配置示例
# ==============================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据你的实际环境修改下面的配置值
# 3. 运行: docker-compose up -d

# ==============================================
# 数据库配置
# ==============================================
# MySQL根用户密码
MYSQL_ROOT_PASSWORD=your_strong_root_password_here

# MySQL数据库名
MYSQL_DATABASE=diary_db

# MySQL应用用户名和密码（应用将使用此用户连接）
MYSQL_USER=diary
MYSQL_PASSWORD=your_strong_db_password_here

# MySQL端口映射（宿主机端口:容器端口）
MYSQL_PORT=3306

# ==============================================
# 应用服务配置
# ==============================================
# 应用服务端口映射（宿主机端口:容器端口）
SERVER_PORT=7080

# Dockerfile选择（可选配置）
# DOCKERFILE=Dockerfile        # Linux AMD64推荐（支持BuildKit缓存）
# DOCKERFILE=Dockerfile.mac    # Mac用户推荐（兼容性更好）

# JWT密钥（请使用强密钥，建议64位以上随机字符串）
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long_for_security_purpose

# ==============================================
# 微信小程序配置
# ==============================================
# 微信小程序AppID和Secret
WX_APPID=your_wechat_miniprogram_appid_here
WX_SECRET=your_wechat_miniprogram_secret_here

# ==============================================
# 安卓应用配置  
# ==============================================
# 安卓应用ID（用作管理员Token）
ANDROID_APPID=your_android_app_id_here

# ==============================================
# AI分析功能配置（可选）
# ==============================================
# AI API服务地址（留空则使用模拟数据）
AI_API_URL=https://your-ai-service.com/api/analyze

# AI API密钥
AI_API_KEY=your_ai_api_key_here

# AI模型名称
AI_MODEL=gpt-3.5-turbo

# 是否启用AI分析功能（true/false）
TODO_ANALYSIS_ENABLED=true

# AI分析定时任务执行时间（Cron表达式，默认每日凌晨1点）
TODO_ANALYSIS_CRON=0 0 1 * * ?

# ==============================================
# 安全建议
# ==============================================
# 1. 请确保所有密码都使用强密码
# 2. JWT_SECRET 应该是随机生成的长字符串
# 3. 生产环境请勿使用默认密码
# 4. 建议定期更换密钥和密码
# 5. 不要将 .env 文件提交到版本控制系统